# Supabase do projeto NOVO desta página (Settings → API). A chave secreta fica só no servidor.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Link do grupo de WhatsApp para onde a pessoa vai depois de se inscrever
GRUPO_WHATSAPP_URL=https://chat.whatsapp.com/XXXXXXXX

# Meta — pixel (PageView ao abrir + evento de inscrição) e API de Conversões (mesmo evento, pelo servidor)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Nome do evento de inscrição. Padrão: Lead
NEXT_PUBLIC_META_EVENTO_LEAD=Lead
# Só para testar no Gerenciador de Eventos → Eventos de teste (apague depois)
META_TEST_EVENT_CODE=
